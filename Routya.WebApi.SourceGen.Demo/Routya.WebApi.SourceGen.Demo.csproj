<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Nullable warnings in source-generated code — generator doesn't yet propagate nullable annotations -->
    <NoWarn>CS8619;CS8603;CS8631</NoWarn>
    <!-- Write generated .cs files to obj/Generated so they are inspectable -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routya.Core\Routya.Core.csproj" />
    <!-- In production: dotnet add package Routya -->
    <ProjectReference Include="..\Routya.SourceGenerators\Routya.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
