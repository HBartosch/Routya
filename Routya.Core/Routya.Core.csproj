<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <Version>4.0.0</Version>
    <SignAssembly>False</SignAssembly>
    <Title>Routya</Title>
    <Authors>Henry Bartosch</Authors>
    <Copyright>Copyright (c) Henry Bartosch</Copyright>
	<PackageId>Routya.Core</PackageId>
    <RepositoryUrl>https://github.com/HBartosch/Routya</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://routya.github.io/</PackageProjectUrl>
    <PackageTags>dispatcher, request, response, notification</PackageTags>
    <Description>request and notification dispatcher</Description>
    <PackageReleaseNotes>See CHANGELOG.md at https://github.com/HBartosch/Routya/blob/main/CHANGELOG.md</PackageReleaseNotes>
	<PackageIcon>PackageIconResized.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Runs the trimming and AOT analyzers on the .NET targets, so that a change which breaks
    trimming or Native AOT compatibility fails the build here rather than in a consumer's
    published application. Not applicable to the netstandard targets, which predate the analyzers.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
  </ItemGroup>

  <!--
    netstandard2.0 predates IAsyncEnumerable<T>, which the streaming API is built on. This package
    supplies it, so streaming is available on every target framework rather than only some. The
    netstandard2.1 and .NET targets have it in the base class library already.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.4" />
  </ItemGroup>

   <ItemGroup>
       <None Include="LICENSE" Pack="true" PackagePath="" />
	   <None Include="..\README.md" Pack="true" PackagePath="" />
	   <None Include="PackageIconResized.png" Pack="true" PackagePath="" />
   </ItemGroup>

</Project>
